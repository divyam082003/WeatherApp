<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/locationListBG"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.LocationListActivity"
    android:background="@drawable/bg_lt"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#66000000"
        >


        <SearchView
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Search for a city"
            android:layout_margin="8dp"
            android:padding="8dp"
            android:background="@drawable/list_image_bg"
            />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:id="@+id/currentLocationLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    >

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:cardCornerRadius="8dp"
                        android:padding="8dp"
                        android:backgroundTint="#99000000"
                        >

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            >

                            <TextView
                                android:id="@+id/cityNameCurrentTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:text="City"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                android:layout_margin="4dp"
                                />

                            <TextView
                                android:id="@+id/tempCurrentTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="22sp"
                                android:text="35 C"
                                android:textColor="@color/blue"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"
                                app:layout_constraintTop_toBottomOf="@id/cityNameCurrentTV"
                                app:layout_constraintLeft_toLeftOf="@id/cityNameCurrentTV"
                                />

                            <TextView
                                android:id="@+id/weatherDescCurrentTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:text="cloudy"
                                android:textColor="@color/white"
                                android:layout_marginTop="4dp"
                                app:layout_constraintTop_toBottomOf="@id/tempCurrentTV"
                                app:layout_constraintLeft_toLeftOf="@id/cityNameCurrentTV"
                                />

                            <ImageView
                                android:id="@+id/weatherIconCurrentIV"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:layout_constraintTop_toTopOf="@id/cityNameCurrentTV"
                                app:layout_constraintBottom_toBottomOf="@id/weatherDescCurrentTV"
                                app:layout_constraintRight_toRightOf="parent"
                                android:layout_marginRight="4dp"
                                android:src="@drawable/cloudy"
                                android:background="@drawable/list_image_bg"
                                />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/locationsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:layout_marginBottom="8dp"
                    tools:listitem="@layout/location_list_item"
                    />

            </LinearLayout>

        </ScrollView>



    </LinearLayout>
    


</LinearLayout>